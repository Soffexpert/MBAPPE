{% comment %}
  Farg-/tygprickar – bilder fran Shopify Innehall > Filer.

  ============================================================
  ENKLASTE (rekommenderas): klistra in fillankar pa HUVUDPRODUKTEN
  ============================================================
  1. Shopify Admin → Innehåll → Filer → Ladda upp tygbilder
  2. Kopiera lank till varje fil (cdn.shopify.com/...)
  3. Pa KRAMEN (huvudprodukten), lagg taggar:

       soffa-grupp
       soffa-huvud
       farg-total:12

       prick-bild:https://cdn.shopify.com/s/files/.../beige.png
       prick-bild:https://cdn.shopify.com/s/files/.../bla.png|Blå
       prick-bild:https://cdn.shopify.com/s/files/.../gra.png|Grå
       prick-bild:https://cdn.shopify.com/s/files/.../gron.png|Grön

     Format:  prick-bild:URL
     eller:   prick-bild:URL|Färgnamn

  Max 4 prickar visas, sedan +N fran farg-total.

  ============================================================
  ALTERNATIV: Active fargprodukter (om du vill lanka till egna sidor)
  ============================================================
  Taggar pa varje fargprodukt:
    soffa-grupp
    dolj-i-rutnat
    farg:Beige
    prick-bild:https://cdn.shopify.com/.../beige.png   (valfritt; annars huvudbild)

  Maste ligga i collection soffgrupp (eller alla-soffor).
  Arkiverade produkter syns ALDRIG.
{% endcomment %}

{% if product != blank and product.tags contains 'soffa-grupp' %}
  {% assign max_dots = 4 %}
  {% assign total_colors = 0 %}
  {% assign file_dot_count = 0 %}

  {% for tag in product.tags %}
    {% assign tag_down = tag | downcase %}
    {% if tag_down contains 'farg-total:' %}
      {% assign total_parts = tag | split: ':' %}
      {% assign total_colors = total_parts | last | strip | plus: 0 %}
    {% endif %}
    {% if tag_down contains 'prick-bild:' %}
      {% assign file_dot_count = file_dot_count | plus: 1 %}
    {% endif %}
  {% endfor %}

  {% assign extra_count = 0 %}
  {% if total_colors > max_dots %}
    {% assign extra_count = total_colors | minus: max_dots %}
  {% endif %}

  {% assign shown = 0 %}
  {% assign dots_style_printed = false %}

  {% if file_dot_count > 0 %}
    {% comment %} === Lagge 1: bildlankar pa huvudprodukten === {% endcomment %}
    <ul class="sofa-grupp-dots" role="list" aria-label="Tillgängliga färger och tyger">
      {% for tag in product.tags %}
        {% assign tag_down = tag | downcase %}
        {% if tag_down contains 'prick-bild:' and shown < max_dots %}
          {% assign colon_parts = tag | split: ':' %}
          {% assign prefix_ok = colon_parts | first | downcase %}
          {% if prefix_ok == 'prick-bild' %}
            {% assign rebuilt = '' %}
            {% for p in colon_parts %}
              {% if forloop.index0 >= 1 %}
                {% if rebuilt == blank %}
                  {% assign rebuilt = p %}
                {% else %}
                  {% assign rebuilt = rebuilt | append: ':' | append: p %}
                {% endif %}
              {% endif %}
            {% endfor %}
            {% assign payload_parts = rebuilt | split: '|' %}
            {% assign prick_url = payload_parts | first | strip %}
            {% assign prick_name = '' %}
            {% if payload_parts.size > 1 %}
              {% assign prick_name = payload_parts[1] | strip %}
            {% endif %}

            {% if prick_url != blank %}
              {% assign shown = shown | plus: 1 %}
              {% if prick_name == blank %}
                {% assign prick_name = 'Färg ' | append: shown %}
              {% endif %}
              <li>
                <a
                  class="sofa-grupp-dots__dot{% if shown == 1 %} is-active{% endif %}"
                  href="{{ product.url }}"
                  title="{{ prick_name | escape }}"
                  aria-label="{{ prick_name | escape }}"
                  style="background-image: url({{ prick_url }});"
                >
                  <span class="visually-hidden">{{ prick_name | escape }}</span>
                </a>
              </li>
            {% endif %}
          {% endif %}
        {% endif %}
      {% endfor %}

      {% if shown >= max_dots and extra_count > 0 %}
        <li>
          <a class="sofa-grupp-dots__more" href="{{ product.url }}" aria-label="{{ extra_count }} fler färger">+{{ extra_count }}</a>
        </li>
      {% endif %}
    </ul>
    {% assign dots_style_printed = true %}

  {% else %}
    {% comment %} === Lagge 2: Active syskon-produkter === {% endcomment %}
    {% assign group_source = collections.soffgrupp %}
    {% if group_source == blank or group_source.products.size == 0 %}
      {% assign group_source = collections['alla-soffor'] %}
    {% endif %}

    {% assign sibling_count = 0 %}
    {% if group_source != blank %}
      {% for sibling in group_source.products %}
        {% if sibling.tags contains 'soffa-grupp' %}
          {% assign sibling_count = sibling_count | plus: 1 %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {% if total_colors < 1 %}
      {% assign total_colors = sibling_count %}
    {% endif %}
    {% assign extra_count = total_colors | minus: max_dots %}
    {% if extra_count < 0 %}
      {% assign extra_count = 0 %}
    {% endif %}

    {% if sibling_count > 0 %}
      <ul class="sofa-grupp-dots" role="list" aria-label="Tillgängliga färger och tyger">
        {% for sibling in group_source.products %}
          {% if sibling.tags contains 'soffa-grupp' and shown < max_dots %}
            {% assign shown = shown | plus: 1 %}

            {% assign color_name = '' %}
            {% assign prick_url = '' %}
            {% for tag in sibling.tags %}
              {% assign tag_down = tag | downcase %}
              {% if tag_down contains 'farg:' %}
                {% assign color_parts = tag | split: ':' %}
                {% assign color_name = color_parts | last | strip %}
              {% endif %}
              {% if tag_down contains 'prick-bild:' %}
                {% assign prick_url = tag | split: 'prick-bild:' | last | strip | split: '|' | first | strip %}
              {% endif %}
            {% endfor %}
            {% if color_name == blank %}
              {% assign title_parts = sibling.title | split: '-' %}
              {% assign color_name = title_parts | last | strip %}
            {% endif %}
            {% if prick_url == blank and sibling.featured_image != blank %}
              {% assign prick_url = sibling.featured_image | image_url: width: 96 %}
            {% endif %}

            <li>
              {% if prick_url != blank %}
                <a
                  class="sofa-grupp-dots__dot{% if sibling.id == product.id %} is-active{% endif %}"
                  href="{{ sibling.url }}"
                  title="{{ color_name | escape }}"
                  aria-label="{{ color_name | escape }}"
                  style="background-image: url({{ prick_url }});"
                >
                  <span class="visually-hidden">{{ color_name | escape }}</span>
                </a>
              {% else %}
                <a
                  class="sofa-grupp-dots__dot{% if sibling.id == product.id %} is-active{% endif %}"
                  href="{{ sibling.url }}"
                  title="{{ color_name | escape }}"
                  aria-label="{{ color_name | escape }}"
                  style="background-color: {{ color_name | handleize }};"
                >
                  <span class="visually-hidden">{{ color_name | escape }}</span>
                </a>
              {% endif %}
            </li>
          {% endif %}
        {% endfor %}

        {% if shown >= max_dots and extra_count > 0 %}
          <li>
            <a class="sofa-grupp-dots__more" href="{{ product.url }}" aria-label="{{ extra_count }} fler färger">+{{ extra_count }}</a>
          </li>
        {% endif %}
      </ul>
      {% assign dots_style_printed = true %}
    {% endif %}
  {% endif %}

  {% if dots_style_printed %}
    <style>
      .sofa-grupp-dots {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        list-style: none;
        margin: 10px 0 0;
        padding: 0;
      }
      .sofa-grupp-dots__dot {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: inline-block;
        background-size: cover;
        background-position: center;
        border: 1px solid rgba(0, 0, 0, 0.18);
        box-sizing: border-box;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
      }
      .sofa-grupp-dots__dot.is-active {
        box-shadow: 0 0 0 2px #111;
      }
      .sofa-grupp-dots__more {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 28px;
        height: 22px;
        padding: 0 6px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        line-height: 1;
        color: #111;
        text-decoration: none;
        background: #f2f2f2;
        border: 1px solid rgba(0, 0, 0, 0.12);
      }
      .sofa-grupp-dots__more:hover {
        background: #e8e8e8;
      }
    </style>
  {% endif %}
{% endif %}
