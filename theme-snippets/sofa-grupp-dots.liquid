{% comment %}
  Farg-/tygprickar via TAGGAAR (inga metafalt kravs).

  HUVUDPRODUKT (syns i rutnatet), t.ex. KRAMEN:
    soffa-grupp
    soffa-huvud
    farg-total:12          (valfritt – totalt antal farger for +N.
                            Om saknas raknas antalet produkter med soffa-grupp)

  VARJE FARG-/TYGPRODUKT (egen produkt, dold i rutnatet):
    soffa-grupp
    dolj-i-rutnat
    farg:Beige             (eller farg:Bla, farg:Sammet gra, ...)

  Bilden i pricken = produktens huvudbild (featured image).
  Valj alltsa prickbilden genom att satta ratt huvudbild pa varje fargprodukt.

  Visning: max 4 prickar, sedan +N (t.ex. +8 om total ar 12).
{% endcomment %}

{% if product != blank and product.tags contains 'soffa-grupp' %}
  {% assign max_dots = 4 %}
  {% assign total_colors = 0 %}

  {% for tag in product.tags %}
    {% assign tag_down = tag | downcase %}
    {% if tag_down contains 'farg-total:' %}
      {% assign total_parts = tag | split: ':' %}
      {% assign total_colors = total_parts | last | strip | plus: 0 %}
    {% endif %}
  {% endfor %}

  {% assign group_source = collections.soffgrupp %}
  {% if group_source == blank or group_source.products.size == 0 %}
    {% assign group_source = collections['alla-soffor'] %}
  {% endif %}

  {% assign sibling_count = 0 %}
  {% if group_source != blank %}
    {% for sibling in group_source.products %}
      {% if sibling.tags contains 'soffa-grupp' %}
        {% assign sibling_count = sibling_count | plus: 1 %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% if total_colors < 1 %}
    {% assign total_colors = sibling_count %}
  {% endif %}

  {% comment %}
    +N visas bara nar vi faktiskt fyllt 4 prickar.
    Annars (t.ex. bara 1 taggad farg) blir det bara 1 cirkel utan missvisande +8.
  {% endcomment %}
  {% assign extra_count = total_colors | minus: max_dots %}
  {% if extra_count < 0 %}
    {% assign extra_count = 0 %}
  {% endif %}

  {% assign shown = 0 %}

  {% if sibling_count > 0 %}
    <ul
      class="sofa-grupp-dots"
      role="list"
      aria-label="Tillgängliga färger och tyger"
    >
      {% comment %} 1) Visa huvudprodukten forst {% endcomment %}
      {% for sibling in group_source.products %}
        {% if sibling.id == product.id and sibling.tags contains 'soffa-grupp' and shown < max_dots %}
          {% assign shown = shown | plus: 1 %}
          {% assign color_name = '' %}
          {% for tag in sibling.tags %}
            {% assign tag_down = tag | downcase %}
            {% if tag_down contains 'farg:' %}
              {% assign color_parts = tag | split: ':' %}
              {% assign color_name = color_parts | last | strip %}
            {% endif %}
          {% endfor %}
          {% if color_name == blank %}
            {% assign title_parts = sibling.title | split: '-' %}
            {% assign color_name = title_parts | last | strip %}
          {% endif %}
          <li>
            {% if sibling.featured_image != blank %}
              <a
                class="sofa-grupp-dots__dot is-active"
                href="{{ sibling.url }}"
                title="{{ color_name | escape }}"
                aria-label="{{ color_name | escape }}"
                style="background-image: url({{ sibling.featured_image | image_url: width: 96 }});"
              >
                <span class="visually-hidden">{{ color_name | escape }}</span>
              </a>
            {% else %}
              <a
                class="sofa-grupp-dots__dot is-active"
                href="{{ sibling.url }}"
                title="{{ color_name | escape }}"
                aria-label="{{ color_name | escape }}"
                style="background-color: {{ color_name | handleize }};"
              >
                <span class="visually-hidden">{{ color_name | escape }}</span>
              </a>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}

      {% comment %} 2) Ovriga farger upp till 4 prickar {% endcomment %}
      {% for sibling in group_source.products %}
        {% if sibling.id != product.id and sibling.tags contains 'soffa-grupp' and shown < max_dots %}
          {% assign shown = shown | plus: 1 %}

          {% assign color_name = '' %}
          {% for tag in sibling.tags %}
            {% assign tag_down = tag | downcase %}
            {% if tag_down contains 'farg:' %}
              {% assign color_parts = tag | split: ':' %}
              {% assign color_name = color_parts | last | strip %}
            {% endif %}
          {% endfor %}
          {% if color_name == blank %}
            {% assign title_parts = sibling.title | split: '-' %}
            {% assign color_name = title_parts | last | strip %}
          {% endif %}

          <li>
            {% if sibling.featured_image != blank %}
              <a
                class="sofa-grupp-dots__dot"
                href="{{ sibling.url }}"
                title="{{ color_name | escape }}"
                aria-label="{{ color_name | escape }}"
                style="background-image: url({{ sibling.featured_image | image_url: width: 96 }});"
              >
                <span class="visually-hidden">{{ color_name | escape }}</span>
              </a>
            {% else %}
              <a
                class="sofa-grupp-dots__dot"
                href="{{ sibling.url }}"
                title="{{ color_name | escape }}"
                aria-label="{{ color_name | escape }}"
                style="background-color: {{ color_name | handleize }};"
              >
                <span class="visually-hidden">{{ color_name | escape }}</span>
              </a>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}

      {% if shown >= max_dots and extra_count > 0 %}
        <li>
          <a
            class="sofa-grupp-dots__more"
            href="{{ product.url }}"
            aria-label="{{ extra_count }} fler färger"
          >+{{ extra_count }}</a>
        </li>
      {% endif %}
    </ul>

    <style>
      .sofa-grupp-dots {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        list-style: none;
        margin: 10px 0 0;
        padding: 0;
      }
      .sofa-grupp-dots__dot {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: inline-block;
        background-size: cover;
        background-position: center;
        border: 1px solid rgba(0, 0, 0, 0.18);
        box-sizing: border-box;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
      }
      .sofa-grupp-dots__dot.is-active {
        box-shadow: 0 0 0 2px #111;
      }
      .sofa-grupp-dots__more {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 28px;
        height: 22px;
        padding: 0 6px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        line-height: 1;
        color: #111;
        text-decoration: none;
        background: #f2f2f2;
        border: 1px solid rgba(0, 0, 0, 0.12);
      }
      .sofa-grupp-dots__more:hover {
        background: #e8e8e8;
      }
    </style>
  {% endif %}
{% endif %}
